<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<title>LUCHER ROCK</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Nunito:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes popIn{from{transform:scale(.82);opacity:0}to{transform:scale(1);opacity:1}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.15}}
@keyframes slideUp{from{transform:translateY(14px);opacity:0}to{transform:translateY(0);opacity:1}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes recPulse{0%,100%{box-shadow:0 0 0 0 rgba(229,57,53,.5)}50%{box-shadow:0 0 0 10px rgba(229,57,53,0)}}
@keyframes drumBeat{0%,100%{transform:scale(1) rotate(0deg)}30%{transform:scale(1.15) rotate(-4deg)}60%{transform:scale(1.1) rotate(3deg)}}
@keyframes loadBar{0%{width:0%}100%{width:100%}}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
@keyframes msgIn{from{transform:translateX(-16px) scale(.95);opacity:0}to{transform:none;opacity:1}}
@keyframes msgOut{from{transform:translateX(16px) scale(.95);opacity:0}to{transform:none;opacity:1}}

*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-font-smoothing:antialiased}
:root{
  --red:#E53935;--red2:#B71C1C;--amber:#FFB300;
  --bg:#111318;--surface:#1A1D24;--card:#21252E;--card2:#272B35;
  --out:#0B3D2E;--out2:#0D4A38;--in:#21252E;
  --green:#25D366;--teal:#128C7E;--teal2:#075E54;
  --text:#E8EAF0;--muted:#6B7280;--sub:#9CA3AF;
  --border:rgba(255,255,255,.07);
  --shadow:rgba(0,0,0,.4);
  --r8:8px;--r12:12px;--r20:20px;
}
html,body{height:100%;font-family:'Nunito',sans-serif;background:var(--bg);color:var(--text);overflow:hidden}
::-webkit-scrollbar{width:3px}::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:10px}

/* ─── LAYOUT ─── */
.phone{
  width:min(420px,100vw);height:min(860px,100dvh);
  background:var(--bg);border-radius:clamp(0px,3vw,36px);
  overflow:hidden;display:flex;flex-direction:column;
  position:relative;margin:auto;
  box-shadow:0 40px 120px rgba(0,0,0,.9),inset 0 0 0 1px rgba(255,255,255,.06);
}
body{display:flex;align-items:center;justify-content:center;min-height:100vh;
  background:radial-gradient(ellipse at 20% 0%,#1a0a0a 0%,#0a0a14 40%,#080810 100%)}

/* ─── SCREENS ─── */
.screen{display:none;flex-direction:column;flex:1;overflow:hidden;animation:fadeUp .28s ease both}
.screen.active{display:flex}

/* ═══ SPLASH ═══ */
#s-splash{align-items:center;justify-content:center;gap:10px;
  background:radial-gradient(circle at 50% 40%,#1a0808 0%,#0d0d14 60%,var(--bg) 100%)}
.splash-logo{margin-bottom:8px;animation:drumBeat 2s ease-in-out infinite}
.splash-logo svg{width:88px;height:88px}
.splash-name{font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:8px;
  background:linear-gradient(135deg,#E53935,#FFB300 60%,#E53935);
  background-size:200% 100%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;
  animation:shimmer 3s linear infinite}
.splash-tagline{color:var(--muted);font-size:11px;letter-spacing:3px;text-transform:uppercase;font-weight:700}
.splash-bar{width:64px;height:3px;background:var(--card);border-radius:4px;overflow:hidden;margin-top:24px}
.splash-bar-fill{height:100%;background:linear-gradient(90deg,var(--red),var(--amber));border-radius:4px;animation:loadBar 1.9s ease forwards}

/* ═══ AUTH ═══ */
#s-auth{align-items:center;justify-content:center;padding:20px;
  background:radial-gradient(circle at 50% 0%,#1a0808 0%,var(--bg) 60%)}
.auth-logo{display:flex;align-items:center;gap:12px;margin-bottom:28px}
.auth-logo svg{width:44px;height:44px;filter:drop-shadow(0 0 14px #E53935)}
.auth-logo-name{font-family:'Bebas Neue',sans-serif;font-size:34px;letter-spacing:5px;
  background:linear-gradient(135deg,#E53935,#FFB300);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.auth-card{background:var(--surface);border-radius:22px;padding:26px 22px;width:100%;max-width:360px;
  border:1px solid var(--border);box-shadow:0 24px 60px rgba(0,0,0,.6)}
.auth-tabs{display:flex;gap:4px;background:var(--bg);border-radius:14px;padding:4px;margin-bottom:22px}
.auth-tab{flex:1;padding:10px;border:none;background:none;color:var(--muted);border-radius:11px;
  font-family:'Nunito',sans-serif;font-weight:800;font-size:13px;cursor:pointer;transition:all .2s;letter-spacing:.5px}
.auth-tab.on{background:linear-gradient(135deg,var(--red),var(--red2));color:#fff;
  box-shadow:0 4px 16px rgba(229,57,53,.4)}
.fg{margin-bottom:14px}
.fg label{display:block;font-size:10.5px;font-weight:800;color:var(--muted);margin-bottom:5px;
  letter-spacing:1.2px;text-transform:uppercase}
.fg input{width:100%;padding:11px 14px;background:var(--bg);border:1.5px solid var(--border);
  border-radius:12px;color:var(--text);font-family:'Nunito',sans-serif;font-size:14px;
  outline:none;transition:border-color .2s}
.fg input:focus{border-color:var(--red)}
.btn-auth{width:100%;padding:13px;background:linear-gradient(135deg,var(--red),var(--red2));
  border:none;border-radius:12px;color:#fff;font-family:'Nunito',sans-serif;
  font-weight:900;font-size:15px;cursor:pointer;letter-spacing:.5px;
  transition:transform .15s,box-shadow .15s;margin-top:6px;
  box-shadow:0 6px 20px rgba(229,57,53,.35)}
.btn-auth:active{transform:scale(.97)}
.auth-err{color:#FF5252;font-size:12px;margin-top:8px;text-align:center;min-height:18px}
.auth-hint{text-align:center;font-size:12px;color:var(--muted);margin-top:10px}

/* ═══ TOPBAR ═══ */
.topbar{
  background:var(--teal2);padding:10px 14px;
  display:flex;align-items:center;gap:10px;flex-shrink:0;
  border-bottom:1px solid rgba(255,255,255,.06);
  box-shadow:0 2px 16px rgba(0,0,0,.5);
}
.topbar-logo{display:flex;align-items:center;gap:8px;flex:1}
.topbar-logo svg{width:28px;height:28px}
.topbar-logo-name{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:4px;
  background:linear-gradient(90deg,#fff,#FFB300);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.topbar-user{font-size:11px;color:rgba(255,255,255,.6);font-weight:600}
.ic-btn{width:36px;height:36px;border:none;background:rgba(255,255,255,.12);border-radius:50%;
  color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;
  font-size:16px;transition:background .2s;flex-shrink:0}
.ic-btn:hover{background:rgba(255,255,255,.22)}

/* ─── TABS ─── */
.tabs{display:flex;background:var(--teal2);border-bottom:2px solid rgba(255,255,255,.08);flex-shrink:0}
.tab{flex:1;padding:11px 4px;border:none;background:none;color:rgba(255,255,255,.55);
  font-family:'Nunito',sans-serif;font-weight:700;font-size:11.5px;cursor:pointer;
  border-bottom:2.5px solid transparent;transition:all .2s;letter-spacing:.4px;
  position:relative;transform:translateY(2px)}
.tab.on{color:#fff;border-bottom-color:#fff}
.tab-dot{position:absolute;top:7px;right:calc(50% - 18px);
  width:8px;height:8px;border-radius:50%;background:var(--red);
  display:none;box-shadow:0 0 6px var(--red)}
.tab-dot.show{display:block}

/* ─── PANELS ─── */
.panel{flex:1;overflow-y:auto;display:flex;flex-direction:column}

/* ─── SEARCH BAR ─── */
.srch{background:var(--surface);padding:9px 14px;flex-shrink:0}
.srch input{width:100%;background:var(--card);border:1px solid var(--border);
  border-radius:22px;padding:9px 16px;font-size:13px;color:var(--text);
  font-family:'Nunito',sans-serif;outline:none;transition:border-color .2s}
.srch input:focus{border-color:var(--teal)}
.srch input::placeholder{color:var(--muted)}

/* ─── CHAT ROW ─── */
.crow{display:flex;align-items:center;gap:12px;padding:13px 16px;
  border-bottom:1px solid var(--border);cursor:pointer;transition:background .15s;background:var(--surface)}
.crow:active{background:var(--card)}
.av{border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-weight:900;color:#fff;flex-shrink:0;position:relative}
.online-pip{position:absolute;bottom:1px;right:1px;width:11px;height:11px;
  border-radius:50%;background:var(--green);border:2px solid var(--surface)}
.crow-info{flex:1;min-width:0}
.crow-name{font-size:14.5px;font-weight:800;color:var(--text);margin-bottom:2px}
.crow-last{font-size:12px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.crow-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0}
.crow-time{font-size:10.5px;color:var(--muted)}
.unread{background:var(--green);color:#000;font-size:10px;font-weight:900;
  min-width:18px;height:18px;border-radius:9px;padding:0 4px;
  display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace}

/* ─── REQUEST ROW ─── */
.rrow{background:var(--surface);border-bottom:1px solid var(--border);padding:14px 16px}
.rrow-top{display:flex;align-items:center;gap:12px;margin-bottom:10px}
.rrow-name{font-size:14px;font-weight:800;color:var(--text)}
.rrow-sub{font-size:11.5px;color:var(--muted);margin-top:2px}
.rrow-btns{display:flex;gap:8px}
.rbtn{flex:1;padding:9px;border-radius:22px;border:none;font-size:13px;font-weight:700;
  cursor:pointer;font-family:'Nunito',sans-serif;transition:all .2s}
.rbtn.accept{background:linear-gradient(135deg,var(--green),var(--teal));color:#fff}
.rbtn.decline{background:var(--card);color:var(--muted)}
.rbtn.decline:active{background:var(--card2)}

/* tags */
.tag{font-size:11px;font-weight:700;padding:4px 10px;border-radius:10px}
.tag-pending{background:rgba(255,179,0,.12);color:var(--amber);border:1px solid rgba(255,179,0,.25)}
.tag-connected{background:rgba(37,211,102,.1);color:var(--green);border:1px solid rgba(37,211,102,.2)}

/* ─── PEOPLE ROW ─── */
.prow{display:flex;align-items:center;gap:12px;padding:12px 16px;
  border-bottom:1px solid var(--border);background:var(--surface)}
.prow-name{font-size:14px;font-weight:800;color:var(--text)}
.prow-bio{font-size:11.5px;color:var(--muted);margin-top:2px}
.add-btn{background:linear-gradient(135deg,var(--green),var(--teal));color:#fff;border:none;
  border-radius:20px;padding:7px 14px;font-size:12px;font-weight:800;
  cursor:pointer;font-family:'Nunito',sans-serif;transition:all .2s;white-space:nowrap;
  box-shadow:0 2px 10px rgba(37,211,102,.25)}
.add-btn:active{transform:scale(.95)}
.add-btn:disabled,.add-btn.sent{background:var(--card);color:var(--muted);box-shadow:none}

/* ─── EMPTY STATE ─── */
.empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:10px;padding:40px;text-align:center}
.empty-icon{font-size:48px;opacity:.5}
.empty p{font-size:13px;color:var(--muted);line-height:1.7}

/* ─── SECTION LABEL ─── */
.sec-lbl{background:var(--bg);padding:7px 16px;font-size:10.5px;font-weight:800;
  color:var(--muted);letter-spacing:1.2px;text-transform:uppercase;flex-shrink:0}

/* ─── FAB ─── */
.fab{position:absolute;bottom:80px;right:16px;width:54px;height:54px;border-radius:50%;
  background:linear-gradient(135deg,var(--green),var(--teal));border:none;
  color:#fff;font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;
  box-shadow:0 6px 22px rgba(37,211,102,.45);transition:transform .15s;z-index:20}
.fab:active{transform:scale(.92)}

/* ═══ CHAT SCREEN ═══ */
#s-chat{background:var(--bg)}
.chat-bar{background:var(--teal2);padding:9px 12px;display:flex;align-items:center;gap:10px;
  flex-shrink:0;box-shadow:0 2px 16px rgba(0,0,0,.5)}
.back-btn{width:34px;height:34px;border:none;background:rgba(255,255,255,.1);
  border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;color:#fff;font-size:18px;transition:background .2s}
.back-btn:hover{background:rgba(255,255,255,.2)}
.chat-bar-info{flex:1}
.chat-bar-name{font-size:15px;font-weight:800;color:#fff;line-height:1.2}
.chat-bar-st{font-size:11px;color:rgba(255,255,255,.65)}
.chat-bar-icons{display:flex;gap:8px}
.chat-bar-icons button{background:rgba(255,255,255,.12);border:none;width:34px;height:34px;
  border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:16px;transition:background .2s}
.chat-bar-icons button:hover{background:rgba(255,255,255,.22)}

/* messages */
.msgs-wrap{flex:1;overflow-y:auto;padding:10px 10px 6px;display:flex;flex-direction:column;gap:3px;
  background:var(--bg) url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.018'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E")}
.ddiv{text-align:center;margin:8px 0}
.ddiv span{background:rgba(0,0,0,.4);color:var(--sub);font-size:10.5px;padding:3px 12px;
  border-radius:10px;font-weight:700;backdrop-filter:blur(4px)}

.bw{display:flex;flex-direction:column;max-width:80%}
.bw.out{align-self:flex-end;align-items:flex-end;animation:msgOut .18s ease both}
.bw.in{align-self:flex-start;align-items:flex-start;animation:msgIn .18s ease both}

/* text bubble */
.bb{padding:7px 11px 5px;font-size:13.5px;line-height:1.5;word-break:break-word;
  box-shadow:0 1px 4px var(--shadow)}
.bw.out .bb{background:var(--out);border-radius:14px 14px 4px 14px}
.bw.in  .bb{background:var(--in);border-radius:14px 14px 14px 4px}
.meta{display:flex;justify-content:flex-end;align-items:center;gap:3px;margin-top:2px;padding-right:2px}
.tm{font-size:10px;color:var(--muted);font-family:'JetBrains Mono',monospace}
.tk{font-size:11px;color:#53bdeb}

/* media bubble */
.mb{border-radius:12px;overflow:hidden;max-width:240px;cursor:pointer;position:relative;
  box-shadow:0 2px 10px var(--shadow)}
.mb img{width:100%;display:block;max-height:240px;object-fit:cover}
.mb video{width:100%;display:block;max-height:220px;background:#000}
.mb-meta{position:absolute;bottom:0;right:0;background:rgba(0,0,0,.55);
  padding:3px 8px 4px;border-top-left-radius:8px;display:flex;align-items:center;gap:3px}
.mb-meta .tm{color:rgba(255,255,255,.85)}.mb-meta .tk{color:#a5f3b4}
.play-ov{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:50px;height:50px;border-radius:50%;background:rgba(0,0,0,.6);
  display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.play-ov svg{width:24px;height:24px;fill:#fff;margin-left:3px}

/* audio bubble */
.ab{border-radius:12px;padding:9px 11px;display:flex;align-items:center;gap:9px;
  min-width:210px;box-shadow:0 1px 4px var(--shadow)}
.bw.out .ab{background:var(--out2)}.bw.in .ab{background:var(--in)}
.apb{width:38px;height:38px;border-radius:50%;background:var(--teal);border:none;
  cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .2s}
.apb:hover{background:var(--teal2)}
.apb svg{width:16px;height:16px;fill:#fff}
.aw{flex:1;display:flex;align-items:center;gap:2px;height:28px;cursor:pointer}
.aw span{width:3px;border-radius:2px;background:var(--teal);opacity:.5;transition:opacity .2s}
.aw span.played{opacity:1;background:var(--green)}
.adur{font-size:11px;color:var(--sub);font-family:'JetBrains Mono',monospace;white-space:nowrap}

/* doc bubble */
.doc-bb{border-radius:12px;padding:10px;min-width:200px;box-shadow:0 1px 4px var(--shadow);cursor:pointer}
.bw.out .doc-bb{background:var(--out)}.bw.in .doc-bb{background:var(--in)}
.doc-inner{display:flex;align-items:center;gap:10px}
.doc-icon{width:44px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.doc-icon span{color:#fff;font-size:9px;font-weight:900;font-family:'JetBrains Mono',monospace}
.doc-name{font-size:12.5px;font-weight:700;color:var(--text);word-break:break-all}
.doc-size{font-size:10.5px;color:var(--muted)}

/* ─── INPUT AREA ─── */
.ia{background:var(--surface);padding:8px 10px;
  padding-bottom:calc(8px + env(safe-area-inset-bottom));
  display:flex;align-items:flex-end;gap:8px;flex-shrink:0;
  border-top:1px solid var(--border);position:relative}
.ib{flex:1;background:var(--card);border-radius:24px;
  display:flex;align-items:center;padding:7px 12px;gap:8px;
  box-shadow:0 1px 4px var(--shadow);min-height:44px;
  border:1px solid var(--border)}
.ib button{background:none;border:none;cursor:pointer;padding:0;
  display:flex;align-items:center;flex-shrink:0;color:var(--muted);transition:color .2s}
.ib button:hover{color:var(--teal)}
#ti{flex:1;border:none;outline:none;font-family:'Nunito',sans-serif;
  font-size:14px;color:var(--text);background:transparent;resize:none;
  max-height:100px;line-height:1.45}
#ti::placeholder{color:var(--muted)}
.send-btn{width:46px;height:46px;border-radius:50%;
  background:linear-gradient(135deg,var(--teal),var(--teal2));border:none;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;box-shadow:0 3px 12px rgba(18,140,126,.4);transition:all .2s}
.send-btn:active{transform:scale(.93)}
.mic-btn{width:46px;height:46px;border-radius:50%;
  background:linear-gradient(135deg,var(--teal),var(--teal2));border:none;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;box-shadow:0 3px 12px rgba(18,140,126,.4);
  transition:all .2s;touch-action:none;-webkit-user-select:none;user-select:none}
.mic-btn.rec{background:linear-gradient(135deg,var(--red),var(--red2));
  animation:recPulse .9s ease-in-out infinite}

/* recording bar */
.rec-bar{background:rgba(229,57,53,.12);padding:8px 16px;display:none;
  align-items:center;gap:10px;flex-shrink:0;border-top:1px solid rgba(229,57,53,.2);
  border-bottom:1px solid rgba(229,57,53,.1)}
.rec-bar.on{display:flex}
.rec-dot{width:9px;height:9px;border-radius:50%;background:var(--red);animation:blink 1s infinite;flex-shrink:0}
.rec-timer{font-size:14px;font-weight:800;color:var(--red);font-family:'JetBrains Mono',monospace}
.rec-hint{flex:1;font-size:11px;color:var(--muted);text-align:right}

/* attach menu */
.am{position:absolute;bottom:64px;left:10px;background:var(--card);border-radius:20px;
  box-shadow:0 12px 40px rgba(0,0,0,.6);padding:14px;display:none;
  grid-template-columns:repeat(3,1fr);gap:8px;z-index:100;width:220px;
  animation:slideUp .2s ease both;border:1px solid var(--border)}
.am.open{display:grid}
.ao{display:flex;flex-direction:column;align-items:center;gap:5px;
  padding:10px 4px;border-radius:14px;cursor:pointer;transition:background .15s}
.ao:active{background:rgba(255,255,255,.06)}
.ai{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  box-shadow:0 4px 14px rgba(0,0,0,.3)}
.ai svg{width:22px;height:22px;fill:#fff}
.al{font-size:10px;color:var(--sub);font-weight:700;text-align:center}
input[type=file]{display:none}

/* progress toast */
.upload-toast{position:absolute;bottom:70px;left:50%;transform:translateX(-50%);
  background:var(--card);border-radius:14px;padding:10px 18px;
  display:none;align-items:center;gap:10px;z-index:200;min-width:210px;
  border:1px solid var(--border);box-shadow:0 6px 24px rgba(0,0,0,.5)}
.upload-toast.show{display:flex}
.up-bar-wrap{flex:1;height:4px;background:rgba(255,255,255,.1);border-radius:4px;overflow:hidden}
.up-bar{height:100%;background:linear-gradient(90deg,var(--teal),var(--green));
  border-radius:4px;width:0%;transition:width .2s}
.up-pct{font-size:11px;color:var(--sub);font-family:'JetBrains Mono',monospace;white-space:nowrap}

/* lightbox */
.lb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.96);z-index:9999;
  align-items:center;justify-content:center;flex-direction:column}
.lb.open{display:flex;animation:fadeUp .2s ease}
.lb img,.lb video{max-width:96vw;max-height:84vh;border-radius:10px;object-fit:contain}
.lbx{position:absolute;top:20px;right:22px;color:#fff;background:rgba(255,255,255,.14);
  border:none;width:40px;height:40px;border-radius:50%;cursor:pointer;
  display:flex;align-items:center;justify-content:center;font-size:18px;
  backdrop-filter:blur(4px);transition:background .15s}
.lbx:hover{background:rgba(255,255,255,.24)}

/* toast */
.toast{position:absolute;bottom:76px;left:50%;transform:translateX(-50%) translateY(8px);
  background:rgba(0,0,0,.85);color:#fff;padding:8px 18px;border-radius:22px;
  font-size:12.5px;white-space:nowrap;opacity:0;transition:opacity .25s,transform .25s;
  pointer-events:none;z-index:500;backdrop-filter:blur(8px);border:1px solid var(--border)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ─── PROFILE SCREEN ─── */
#s-profile{background:var(--bg);overflow-y:auto}
.profile-hero{background:linear-gradient(160deg,var(--teal2),#0a1a18);padding:30px 20px;
