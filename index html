.profile-name-big{font-family:'Bebas Neue',sans-serif;font-size:30px;letter-spacing:3px;color:#fff}
.profile-username{color:rgba(255,255,255,.55);font-size:13px;font-weight:700}
.profile-item{display:flex;align-items:center;gap:12px;padding:14px 16px;
