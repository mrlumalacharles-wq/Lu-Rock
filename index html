<script>
// ═══════════════════════════════════════════════════════
//  STORAGE HELPERS  (localStorage multi-user DB)
// ═══════════════════════════════════════════════════════
const DB_USERS   = 'lr_users_v1';
const DB_CONVOS  = 'lr_convos_v1';
const DB_MSGS    = 'lr_msgs_v1';
const DB_REQS    = 'lr_reqs_v1';    // { fromUser_toUser: 'sent'|'accepted'|'declined' }
const DB_SESS    = 'lr_session_v1';

function dbGet(key){ try{ return JSON.parse(localStorage.getItem(key))||{} }catch{return {}} }
function dbSet(key,val){ localStorage.setItem(key,JSON.stringify(val)) }
function dbGetArr(key){ try{ return JSON.parse(localStorage.getItem(key))||[] }catch{return []} }
function dbSetArr(key,val){ localStorage.setItem(key,JSON.stringify(val)) }

// ─── users: { username: { name, username, phone, pw(btoa), color, joined } }
function getUsers(){ return dbGet(DB_USERS) }
function saveUser(u){ const d=getUsers(); d[u.username]=u; dbSet(DB_USERS,d) }
function getUser(u){ return getUsers()[u]||null }

// ─── conversations: { convId: { members[], lastMsg, lastAt } }
function getConvos(){ return dbGet(DB_CONVOS) }
function saveConvo(id,data){ const d=getConvos(); d[id]={...d[id],...data}; dbSet(DB_CONVOS,d) }

// ─── messages: { convId: [ {type,sender,senderName,text/url/...,at} ] }
function getMsgs(convId){ const d=dbGet(DB_MSGS); return d[convId]||[] }
function addMsg(convId,msg){ const d=dbGet(DB_MSGS); d[convId]=[...(d[convId]||[]),msg]; dbSet(DB_MSGS,d) }

// ─── requests: { key: status }  key = `${from}__${to}`
function getReqs(){ return dbGet(DB_REQS) }
function reqKey(a,b){ return a+'__'+b }
function setReq(from,to,status){ const d=getReqs(); d[reqKey(from,to)]=status; dbSet(DB_REQS,d) }
function getReqStatus(from,to){ return getReqs()[reqKey(from,to)]||'none' }
function convId(a,b){ return [a,b].sort().join('__') }

// ─── session
function getSession(){ try{return JSON.parse(localStorage.getItem(DB_SESS))||null}catch{return null} }
function saveSession(u){ localStorage.setItem(DB_SESS,JSON.stringify(u)) }
function clearSession(){ localStorage.removeItem(DB_SESS) }

// ═══════════════════════════════════════════════════════
//  GLOBAL STATE
// ═══════════════════════════════════════════════════════
const COLORS=['#C62828','#AD1457','#6A1B9A','#283593','#00695C','#E65100','#4E342E','#37474F'];
function rColor(str){ let h=0;for(let c of str)h=(h*31+c.charCodeAt(0))%COLORS.length;return COLORS[h]; }
function initials(name){ return(name||'?').split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2) }
function nowStr(){ const d=new Date();return d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0') }
function fmtSize(b){ if(b<1024)return b+'B';if(b<1048576)return(b/1024).toFixed(1)+'KB';return(b/1048576).toFixed(1)+'MB' }

let ME = null;
let activeChatUser = null;  // username of the person we're chatting with
let pollingTimer = null;

const MAX = 10*1024*1024;

// ═══════════════════════════════════════════════════════
//  BOOT
// ═══════════════════════════════════════════════════════
window.addEventListener('DOMContentLoaded',()=>{
  const sess = getSession();
  setTimeout(()=>{
    if(sess && getUser(sess.username)){
      ME = getUser(sess.username);
      enterApp();
    } else {
      showScreen('s-auth');
    }
  }, 2000);
});

// ═══════════════════════════════════════════════════════
//  AUTH
// ═══════════════════════════════════════════════════════
function switchAuthTab(tab){
  document.querySelectorAll('.auth-tab').forEach((b,i)=>b.classList.toggle('on',(tab==='login'&&i===0)||(tab==='register'&&i===1)));
  document.getElementById('loginForm').style.display = tab==='login'?'':'none';
  document.getElementById('regForm').style.display = tab==='register'?'':'none';
}

function doRegister(){
  const name=document.getElementById('regName').value.trim();
  const user=document.getElementById('regUser').value.trim().toLowerCase().replace(/\s/g,'_');
  const phone=document.getElementById('regPhone').value.trim();
  const pw=document.getElementById('regPw').value;
  const err=document.getElementById('regErr');
  err.textContent='';
  if(!name||!user||!pw){err.textContent='Please fill all required fields.';return}
  if(pw.length<6){err.textContent='Password must be at least 6 characters.';return}
  if(!/^[a-z0-9_]+$/.test(user)){err.textContent='Username: only letters, numbers, underscores.';return}
  if(getUser(user)){err.textContent='Username already taken!';return}
  const u={name,username:user,phone,pw:btoa(pw),color:rColor(user),joined:Date.now()};
  saveUser(u);
  ME={...u};
  saveSession({username:user});
  enterApp();
}

function doLogin(){
  const user=document.getElementById('loginUser').value.trim().toLowerCase();
  const pw=document.getElementById('loginPw').value;
  const err=document.getElementById('loginErr');
  err.textContent='';
  if(!user||!pw){err.textContent='Enter username and password.';return}
  const u=getUser(user);
  if(!u){err.textContent='User not found.';return}
  if(atob(u.pw)!==pw){err.textContent='Wrong password.';return}
  ME={...u};
  saveSession({username:user});
  enterApp();
}

function doLogout(){
  clearSession();
  ME=null; activeChatUser=null;
  clearInterval(pollingTimer);
  showScreen('s-auth');
}

function enterApp(){
  document.getElementById('topbar-user').textContent = '@'+ME.username;
  showScreen('s-home');
  renderHome();
  // poll for new messages every 2s (simulate real-time for same-browser tabs)
  clearInterval(pollingTimer);
  pollingTimer=setInterval(()=>{ renderChats(); updateReqDot(); if(activeChatUser) pollMessages(); },2000);
}

// ═══════════════════════════════════════════════════════
//  SCREEN NAV
// ═══════════════════════════════════════════════════════
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  const el=document.getElementById(id);
  el.classList.add('active');
  if(id==='s-home') renderHome();
  if(id==='s-profile') renderProfile();
}

// ═══════════════════════════════════════════════════════
//  HOME TABS
// ═══════════════════════════════════════════════════════
function switchTab(tab){
  ['chats','req','ppl'].forEach(t=>{
    document.getElementById('tab-'+t).classList.toggle('on',t===tab);
    document.getElementById('panel-'+t).style.display = t===tab?'flex':'none';
  });
  document.getElementById('new-chat-fab').style.display = tab==='chats'?'flex':'none';
  if(tab==='people') renderPeople();
}

function renderHome(){ renderChats(); renderRequests(); updateReqDot(); }

// ─── CHATS TAB ─────────────────────────────
function renderChats(){
  const list=document.getElementById('chats-list');
  const empty=document.getElementById('chats-empty');
  const reqs=getReqs();
  const users=getUsers();
  // find all accepted connections involving ME
  const connected=Object.entries(reqs)
    .filter(([k,v])=>v==='accepted' && k.includes(ME.username))
    .map(([k])=>{ const parts=k.split('__'); return parts[0]===ME.username?parts[1]:parts[0]; });
  const unique=[...new Set(connected)];

  if(!unique.length){
    empty.style.display='flex'; list.innerHTML=''; return;
  }
  empty.style.display='none';

  // sort by last message time
  const withTimes = unique.map(u=>{
    const cid=convId(ME.username,u);
    const msgs=getMsgs(cid);
    const last=msgs.length?msgs[msgs.length-1]:null;
    return {u, last, at: last?last.at:0};
  }).sort((a,b)=>b.at-a.at);

  list.innerHTML='';
  withTimes.forEach(({u,last})=>{
    const person=getUser(u);
    if(!person)return;
    const nm=person.name||u;
    const col=person.color||rColor(u);
    const t=last?new Date(last.at).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}):'';
    const sub=last?msgPreview(last):(person.phone||'Tap to chat');
    const div=document.createElement('div');
    div.className='crow';
    div.onclick=()=>openChat(u);
    div.innerHTML=`
      <div class="av" style="width:48px;height:48px;font-size:17px;background:${col}">
        ${initials(nm)}<div class="online-pip"></div>
      </div>
      <div class="crow-info">
        <div class="crow-name">${esc(nm)}</div>
        <div class="crow-last">${esc(sub)}</div>
      </div>
      <div class="crow-right"><span class="crow-time">${t}</span></div>`;
    list.appendChild(div);
  });
}

function msgPreview(m){
  if(m.type==='text')return m.text||'';
  if(m.type==='image')return '📷 Photo';
  if(m.type==='video')return '🎥 Video';
  if(m.type==='audio')return '🎵 Audio';
  if(m.type==='voice')return '🎤 Voice message';
  return '📎 '+( m.name||'File');
}

// ─── REQUESTS TAB ─────────────────────────
function renderRequests(){
  const rlist=document.getElementById('req-list');
  const slist=document.getElementById('sent-list');
  const empty=document.getElementById('req-empty');
  const ssec=document.getElementById('sent-section');
  const users=getUsers();
  const reqs=getReqs();

  // received = others sent ME a request
  const received=Object.entries(reqs)
    .filter(([k,v])=>v==='pending' && k.endsWith('__'+ME.username))
    .map(([k])=>k.split('__')[0]);
  // sent = I sent others
  const sent=Object.entries(reqs)
    .filter(([k,v])=>v==='pending' && k.startsWith(ME.username+'__'))
    .map(([k])=>k.split('__')[1]);

  empty.style.display=(!received.length&&!sent.length)?'flex':'none';
  rlist.innerHTML='';
  received.forEach(u=>{
    const p=getUser(u)||{name:u,username:u,color:rColor(u)};
    const d=document.createElement('div');
    d.className='rrow'; d.id='rrow-'+u;
    d.innerHTML=`
      <div class="rrow-top">
        <div class="av" style="width:46px;height:46px;font-size:16px;background:${p.color||rColor(u)}">${initials(p.name||u)}</div>
        <div><div class="rrow-name">${esc(p.name||u)}</div><div class="rrow-sub">@${u} · wants to connect</div></div>
      </div>
      <div class="rrow-btns">
        <button class="rbtn decline" onclick="declineReq('${u}')">Decline</button>
        <button class="rbtn accept" onclick="acceptReq('${u}')">Accept ✓</button>
      </div>`;
    rlist.appendChild(d);
  });

  ssec.style.display=sent.length?'block':'none';
  slist.innerHTML='';
  sent.forEach(u=>{
    const p=getUser(u)||{name:u,username:u,color:rColor(u)};
    const d=document.createElement('div');
    d.className='prow';
    d.innerHTML=`
      <div class="av" style="width:46px;height:46px;font-size:16px;background:${p.color||rColor(u)}">${initials(p.name||u)}</div>
      <div style="flex:1"><div class="prow-name">${esc(p.name||u)}</div><div class="prow-bio">@${u}</div></div>
      <span class="tag tag-pending">Pending…</span>`;
    slist.appendChild(d);
  });
}

function updateReqDot(){
  const reqs=getReqs();
  const n=Object.entries(reqs).filter(([k,v])=>v==='pending'&&k.endsWith('__'+ME.username)).length;
  document.getElementById('req-dot').classList.toggle('show',n>0);
}

function sendReq(toUser){
  if(getReqStatus(ME.username,toUser)!=='none'||getReqStatus(toUser,ME.username)!=='none') return;
  setReq(ME.username,toUser,'pending');
  toast('✅ Request sent to '+toUser+'!');
  renderPeople(); renderRequests();
}

function acceptReq(fromUser){
  setReq(fromUser,ME.username,'accepted');
  // create conversation
  const cid=convId(ME.username,fromUser);
  saveConvo(cid,{members:[ME.username,fromUser],lastMsg:'',lastAt:Date.now()});
  toast('🎉 Connected with '+fromUser+'! Start chatting.');
  renderHome();
  setTimeout(()=>openChat(fromUser),400);
}

function declineReq(fromUser){
  setReq(fromUser,ME.username,'declined');
  renderRequests(); updateReqDot();
  toast('Request declined.');
}

// ─── PEOPLE TAB ─────────────────────────
function renderPeople(){
  const filter=(document.getElementById('ppl-search')||{}).value||'';
  const list=document.getElementById('ppl-list');
  const empty=document.getElementById('ppl-empty');
  const users=getUsers();
  const others=Object.values(users).filter(u=>u.username!==ME.username&&u.name.toLowerCase().includes(filter.toLowerCase()));

  if(!others.length){ empty.style.display='flex'; list.innerHTML=''; return; }
  empty.style.display='none'; list.innerHTML='';

  others.forEach(p=>{
    const myReq=getReqStatus(ME.username,p.username);
    const theirReq=getReqStatus(p.username,ME.username);
    const connected=myReq==='accepted'||theirReq==='accepted';
    const pending=myReq==='pending';
    const theyPending=theirReq==='pending';

    let right='';
    if(connected) right=`<span class="tag tag-connected">✓ Connected</span>`;
    else if(pending) right=`<button class="add-btn sent" disabled>Sent ✓</button>`;
    else if(theyPending) right=`<button class="add-btn" onclick="acceptReq('${p.username}')">Accept ↗</button>`;
    else right=`<button class="add-btn" onclick="sendReq('${p.username}')">+ Connect</button>`;

    const d=document.createElement('div'); d.className='prow';
    d.innerHTML=`
      <div class="av" style="width:46px;height:46px;font-size:16px;background:${p.color||rColor(p.username)}">${initials(p.name)}</div>
      <div style="flex:1"><div class="prow-name">${esc(p.name)}</div><div class="prow-bio">@${p.username}${p.phone?' · '+p.phone:''}</div></div>
      ${right}`;
    list.appendChild(d);
  });
}

// ═══════════════════════════════════════════════════════
//  OPEN CHAT
// ═══════════════════════════════════════════════════════
function openChat(toUser){
  const myReq=getReqStatus(ME.username,toUser);
  const theirReq=getReqStatus(toUser,ME.username);
  if(myReq!=='accepted'&&theirReq!=='accepted'){
    toast('⚠️ Connect with this person first!'); return;
  }
  activeChatUser=toUser;
  const p=getUser(toUser)||{name:toUser,username:toUser,color:rColor(toUser)};
  const av=document.getElementById('chat-av');
  av.textContent=initials(p.name||toUser);
  av.style.background=p.color||rColor(toUser);
  document.getElementById('chat-name').textContent=p.name||toUser;
  document.getElementById('chat-st').textContent='online';
  showScreen('s-chat');
  renderMessages();
  updateSendMic();
}

function backHome(){
  activeChatUser=null;
  showScreen('s-home');
}

// ─── MESSAGES ─────────────────────────────
function renderMessages(){
  const box=document.getElementById('msgs');
  box.innerHTML='<div class="ddiv"><span>Today</span></div>';
  const cid=convId(ME.username,activeChatUser);
  const msgs=getMsgs(cid);
  msgs.forEach(m=>appendMsgEl(m));
  scrollMsgs();
}

let lastMsgCount=0;
function pollMessages(){
  const cid=convId(ME.username,activeChatUser);
  const msgs=getMsgs(cid);
  if(msgs.length>lastMsgCount){
    const box=document.getElementById('msgs');
    for(let i=lastMsgCount;i<msgs.length;i++) appendMsgEl(msgs[i]);
    lastMsgCount=msgs.length;
    scrollMsgs();
  }
}

function appendMsgEl(m){
  const dir=m.sender===ME.username?'out':'in';
  const w=document.createElement('div'); w.className='bw '+dir;
  if(m.type==='text'){
    w.innerHTML=`<div class="bb">${esc(m.text||'').replace(/\n/g,'<br>')}
      <div class="meta"><span class="tm">${fmtAt(m.at)}</span>${dir==='out'?'<span class="tk">✓✓</span>':''}</div>
    </div>`;
  } else if(m.type==='image'){
    const safe=m.url.replace(/'/g,'%27');
    w.innerHTML=`<div class="mb" onclick="openLb('img','${safe}')">
      <img src="${m.url}" loading="lazy" alt="photo">
      <div class="mb-meta"><span class="tm">${fmtAt(m.at)}</span>${dir==='out'?'<span class="tk">✓✓</span>':''}</div>
    </div>`;
  } else if(m.type==='video'){
    const safe=m.url.replace(/'/g,'%27');
    w.innerHTML=`<div class="mb" onclick="openLb('vid','${safe}')">
      <video src="${m.url}" preload="metadata" playsinline></video>
      <div class="play-ov"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
      <div class="mb-meta"><span class="tm">${fmtSize(m.size||0)} · ${fmtAt(m.at)}</span>${dir==='out'?'<span class="tk">✓✓</span>':''}</div>
    </div>`;
  } else if(m.type==='audio'||m.type==='voice'){
    const id='a'+Date.now()+'_'+Math.random().toString(36).slice(2);
    const bars=Array.from({length:24},()=>`<span style="height:${4+Math.floor(Math.random()*20)}px"></span>`).join('');
    w.innerHTML=`<div class="ab">
      <button class="apb" onclick="togAud('${id}',this)"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button>
      <div class="aw" id="aw_${id}">${bars}</div>
      <span class="adur" id="dur_${id}">0:00</span>
      <audio id="${id}" src="${m.url}" preload="metadata"
        onloadedmetadata="setDur('${id}')"
        ontimeupdate="updW('${id}',this)"
        onended="endAud('${id}')"></audio>
    </div>
    <div class="meta" style="margin-top:3px"><span class="tm">${fmtAt(m.at)}</span>${dir==='out'?'<span class="tk">✓✓</span>':''}</div>`;
  } else {
    // doc / generic file
    const ext=(m.name||'').split('.').pop().toLowerCase();
    const colMap={pdf:'#E53935',doc:'#1565C0',docx:'#1565C0',xls:'#2E7D32',xlsx:'#2E7D32',ppt:'#E65100',pptx:'#E65100',txt:'#546E7A'};
    const col=colMap[ext]||'#5c5c5c';
    w.innerHTML=`<div class="doc-bb" onclick="window.open('${m.url}','_blank')">
      <div class="doc-inner">
        <div class="doc-icon" style="background:${col}"><span>${(ext||'?').toUpperCase()}</span></div>
        <div><div class="doc-name">${esc(m.name||'File')}</div><div class="doc-size">${fmtSize(m.size||0)}</div></div>
      </div>
      <div class="meta" style="margin-top:6px"><span class="tm">${fmtAt(m.at)}</span>${dir==='out'?'<span class="tk">✓✓</span>':''}</div>
    </div>`;
  }
  document.getElementById('msgs').appendChild(w);
}

function saveAndShow(m){
  const cid=convId(ME.username,activeChatUser);
  addMsg(cid,m);
  saveConvo(cid,{lastMsg:msgPreview(m),lastAt:m.at,members:[ME.username,activeChatUser]});
  appendMsgEl(m);
  lastMsgCount=getMsgs(cid).length;
  scrollMsgs();
  renderChats();
}

// ─── SEND TEXT ─────────────────────────────
function sendTxt(){
  const ta=document.getElementById('ti'); const txt=ta.value.trim();
  if(!txt||!activeChatUser) return;
  ta.value=''; ta.style.height=''; updateSendMic();
  saveAndShow({type:'text',text:txt,sender:ME.username,senderName:ME.name,at:Date.now()});
  // simulate reply
  setTimeout(()=>{
    const replies=['Got it! 😊','Nice 👍','Sure thing!','Sounds good!','Okay! 🙌','🎸🔥','Cool, thanks!','Haha that\'s great!','On it!'];
    const r=replies[Math.floor(Math.random()*replies.length)];
    if(activeChatUser){
      const cid2=convId(ME.username,activeChatUser);
      addMsg(cid2,{type:'text',text:r,sender:activeChatUser,senderName:activeChatUser,at:Date.now()});
      saveConvo(cid2,{lastMsg:r,lastAt:Date.now()});
    }
  }, 1500+Math.random()*2000);
}

function onKey(e){ if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendTxt();} }
function resizeTa(el){ el.style.height='';el.style.height=Math.min(el.scrollHeight,100)+'px'; }
function updateSendMic(){
  const has=document.getElementById('ti').value.trim().length>0;
  document.getElementById('sendBtn').style.display=has?'flex':'none';
  document.getElementById('micBtn').style.display=has?'none':'flex';
}
document.addEventListener('DOMContentLoaded',updateSendMic);
setTimeout(updateSendMic,200);

// ─── FILE UPLOAD ────────────────────────────
function pickFile(accept,type,capture=false){
  document.getElementById('am').classList.remove('open');
  const fi=document.getElementById('fInput');
  fi.accept=accept; fi.multiple=(type==='image');
  if(capture) fi.setAttribute('capture','environment'); else fi.removeAttribute('capture');
  fi.onchange=e=>handleFile(e,type);
  setTimeout(()=>fi.click(),30);
}

function handleFile(e,type){
  const files=[...e.target.files];
  files.forEach(f=>{
    if(f.size>MAX){ toast(`❌ "${f.name}" exceeds 10MB`); return; }
    fakeUpload(f,type);
  });
  e.target.value='';
}

function fakeUpload(f,type){
  // Show progress (simulate upload)
  const toast2=document.getElementById('upToast');
  const bar=document.getElementById('upBar');
  const pct=document.getElementById('upPct');
  const lbl=document.getElementById('upLabel');
  toast2.classList.add('show');
  lbl.textContent=`Sending ${fmtSize(f.size)}…`;
  bar.style.width='0%'; pct.textContent='0%';
  let p=0;
  const iv=setInterval(()=>{
    p+=Math.random()*25+8;
    if(p>=100){p=100;clearInterval(iv);
      setTimeout(()=>{
        toast2.classList.remove('show');
        const url=URL.createObjectURL(f);
        saveAndShow({type,url,name:f.name,size:f.size,sender:ME.username,senderName:ME.name,at:Date.now()});
      },200);
    }
    bar.style.width=Math.min(p,100)+'%'; pct.textContent=Math.round(p)+'%';
  },80);
}

