// ═══════════════════════════════════════════════════════
//  VOICE RECORDING (hold mic button)
// ═══════════════════════════════════════════════════════
let mr=null, recChunks=[], recSec=0, recIv=null, recStream=null;

async function startRec(){
  if(mr) return;
  try{
    recStream=await navigator.mediaDevices.getUserMedia({audio:true});
    recChunks=[]; recSec=0;
    const mime=MediaRecorder.isTypeSupported('audio/webm;codecs=opus')?'audio/webm;codecs=opus':
                MediaRecorder.isTypeSupported('audio/webm')?'audio/webm':
                MediaRecorder.isTypeSupported('audio/mp4')?'audio/mp4':'audio/ogg';
    mr=new MediaRecorder(recStream,{mimeType:mime});
    mr.ondataavailable=e=>{ if(e.data.size>0)recChunks.push(e.data); };
    mr.start(100);
    document.getElementById('recBar').classList.add('on');
    document.getElementById('micBtn').classList.add('rec');
    recIv=setInterval(()=>{
      recSec++;
      const m=Math.floor(recSec/60),s=String(recSec%60).padStart(2,'0');
      document.getElementById('recTimer').textContent=m+':'+s;
    },1000);
  } catch(e){ toast('🎤 Microphone access denied'); }
}

function stopRec(send){
  if(!mr||mr.state==='inactive'){ resetRecUI(); return; }
  clearInterval(recIv);
  mr.onstop=()=>{
    if(send && recSec>=1){
      const blob=new Blob(recChunks,{type:mr.mimeType||'audio/webm'});
      if(blob.size>MAX){ toast('❌ Recording too large'); }
      else {
        const url=URL.createObjectURL(blob);
        saveAndShow({type:'voice',url,name:'voice.webm',size:blob.size,sender:ME.username,senderName:ME.name,at:Date.now()});
      }
    } else if(send && recSec<1){
      toast('Hold longer to record voice');
    }
    if(recStream) recStream.getTracks().forEach(t=>t.stop());
    resetRecUI();
  };
  mr.stop(); mr=null;
}

function openRecord(){
  document.getElementById('am').classList.remove('open');
  toast('🎤 Hold the mic button to record voice');
}

function resetRecUI(){
  document.getElementById('recBar').classList.remove('on');
  document.getElementById('micBtn').classList.remove('rec');
  document.getElementById('recTimer').textContent='0:00';
  recChunks=[]; recSec=0; mr=null; recStream=null;
}

// ─── AUDIO PLAYER ─────────────────────────────
function setDur(id){const e=document.getElementById(id);if(!isNaN(e.duration)){const m=Math.floor(e.duration/60),s=String(Math.floor(e.duration%60)).padStart(2,'0');document.getElementById('dur_'+id).textContent=m+':'+s;}}
function updW(id,el){const bars=[...document.getElementById('aw_'+id).children];const p=el.currentTime/el.duration;bars.forEach((b,i)=>b.classList.toggle('played',i/bars.length<p));const m=Math.floor(el.currentTime/60),s=String(Math.floor(el.currentTime%60)).padStart(2,'0');document.getElementById('dur_'+id).textContent=m+':'+s;}
function togAud(id,btn){const el=document.getElementById(id);if(el.paused){document.querySelectorAll('audio').forEach(a=>a.pause());document.querySelectorAll('.apb').forEach(b=>{b.innerHTML='<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';});el.play();btn.innerHTML='<svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';}else{el.pause();btn.innerHTML='<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';}}
function endAud(id){const d=document.getElementById('dur_'+id);if(d)d.textContent='0:00';const aw=document.getElementById('aw_'+id);if(aw)[...aw.children].forEach(b=>b.classList.remove('played'));}

