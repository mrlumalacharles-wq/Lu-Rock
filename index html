function openLb(type,url){
  const lb=document.getElementById('lb'),img=document.getElementById('lbImg'),vid=document.getElementById('lbVid');
  if(type==='img'){img.src=url;img.style.display='block';vid.style.display='none';vid.src='';}
  else{vid.src=url;vid.style.display='block';img.style.display='none';img.src='';}
  lb.classList.add('open');
}
function closeLb(){const lb=document.getElementById('lb');lb.classList.remove('open');const v=document.getElementById('lbVid');v.pause();v.src='';}
document.getElementById('lb').addEventListener('click',e=>{if(e.target===e.currentTarget)closeLb();});

